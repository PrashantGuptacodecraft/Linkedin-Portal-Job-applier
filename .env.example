# ── LinkedIn credentials (optional – leave blank to log in manually) ──────────
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# ── Gemini / LLM (optional) ──────────────────────────────────────────────────
GEMINI_API_KEY=

# ── Timing (seconds) ──────────────────────────────────────────────────────────
MIN_DELAY=1.8
MAX_DELAY=4.5

# ── Browser ───────────────────────────────────────────────────────────────────
# Set HEADLESS=true only after confirming manual login works.
HEADLESS=false
