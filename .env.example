# ── LinkedIn credentials (optional – leave blank to log in manually) ──────────
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# ── Gemini / LLM / AI ────────────────────────────────────────────────────────
# One key, or several comma-separated keys for automatic failover when one
# hits its quota:  GEMINI_API_KEY=key1,key2,key3
GEMINI_API_KEY=
# Optional: override the model (default gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_API_KEY=

# ── Portal Master Credentials ────────────────────────────────────────────────
PORTAL_EMAIL=
PORTAL_PASSWORD=

# ── Timing (seconds) ──────────────────────────────────────────────────────────
MIN_DELAY=1.8
MAX_DELAY=4.5

# ── Browser ───────────────────────────────────────────────────────────────────
# Set HEADLESS=true only after confirming manual login works.
HEADLESS=false
