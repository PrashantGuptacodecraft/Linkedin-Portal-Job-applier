# ── LinkedIn credentials (optional – leave blank to log in manually) ──────────
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# ── Gemini / LLM / AI ────────────────────────────────────────────────────────
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ── Portal Master Credentials ────────────────────────────────────────────────
PORTAL_EMAIL=
PORTAL_PASSWORD=

# ── Timing (seconds) ──────────────────────────────────────────────────────────
MIN_DELAY=1.8
MAX_DELAY=4.5

# ── Browser ───────────────────────────────────────────────────────────────────
